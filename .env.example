# Для локального запуска Vite: адрес backend, по умолчанию http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
# Папка исходных CSV (по умолчанию data/raw относительно корня проекта)
DATA_DIR=data/raw
# SQLite-файл успешных запусков при локальном старте; в Compose задан постоянный том
RUNS_DB_PATH=backend/runs.sqlite3
# Ключ доступен только backend. Не используйте префикс VITE_ для секретов.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
